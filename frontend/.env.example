# API base path for axios (Vite dev proxy uses /api by default)
VITE_API_URL=/api

# Backend API origin used for OAuth redirects (must match OAuth callback URLs in provider consoles)
VITE_API_BASE_URL=http://localhost:5000

# Avaturn GLB for mock-interview 3D avatar (export Avatar T-Pose from https://avaturn.me)
# Save to public/models/interviewer/interviewer-avatar.glb or set export URL:
# VITE_INTERVIEWER_AVATAR_URL=https://...

# Body animation clips: npm run download:interviewer-avatar

# Vapi public web token for live AI interviews (https://dashboard.vapi.ai)
VITE_VAPI_WEB_TOKEN=

# Optional: use a pre-built Vapi assistant ID from your dashboard instead of inline config
# VITE_VAPI_ASSISTANT_ID=
