PORT=5000

MONGO_URI=mongodb://127.0.0.1:27017/ai-careerbridge

CLIENT_URL=http://localhost:5173

API_URL=http://localhost:5000

JWT_SECRET=change_me_to_a_long_random_secret_before_production

JWT_EXPIRE=7d

NODE_ENV=development



# Email verification (SMTP)
# Gmail: enable 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords — use that 16-char password as SMTP_PASS.
# Do NOT use your normal Gmail login password.

SMTP_HOST=smtp.gmail.com

SMTP_PORT=587

SMTP_SECURE=false

SMTP_USER=your.email@gmail.com

SMTP_PASS=your_16_char_app_password

EMAIL_FROM="AI CareerBridge <your.email@gmail.com>"

EMAIL_VERIFICATION_EXPIRE_MINUTES=15



# Google OAuth (https://console.cloud.google.com/)

GOOGLE_CLIENT_ID=

GOOGLE_CLIENT_SECRET=

# Optional: OAuth prompt (default: select_account consent)
# Use "select_account" in production if you only want consent on first authorization.
GOOGLE_OAUTH_PROMPT=select_account consent



# Facebook OAuth (https://developers.facebook.com/)

FACEBOOK_APP_ID=

FACEBOOK_APP_SECRET=



# LinkedIn OAuth (https://www.linkedin.com/developers/)

LINKEDIN_CLIENT_ID=

LINKEDIN_CLIENT_SECRET=




# https://console.anthropic.com/

ANTHROPIC_API_KEY=

ANTHROPIC_MODEL=claude-sonnet-4-20250514



# Groq (Resume Builder + Interview Prep — chat/JSON, quiz generation, STT via Whisper on Groq)
# https://console.groq.com/

GROQ_API_KEY=
# Optional second key — used when primary hits rate limit / daily token quota
GROQ_API_KEY_FALLBACK=

GROQ_MODEL=openai/gpt-oss-120b

GROQ_FAST_MODEL=openai/gpt-oss-20b

GROQ_WHISPER_MODEL=whisper-large-v3



# Vapi (Interview Prep live voice) — PRIVATE key for server-side assistant creation only.
# Dashboard → API Keys → Private Key (NOT the public web token).
# Never use VITE_ prefix. Public web token stays on the frontend as VITE_VAPI_WEB_TOKEN.
# Alias: VAPI_API_KEY is also accepted.
# https://dashboard.vapi.ai

VAPI_PRIVATE_KEY=

# Optional speech linguistics via Groq (grammar/vocab/emotion numeric scores only)
# SPEECH_LINGUISTICS_GROQ_ENABLED=true

# Interview intelligence (question guide + prompt enrichment at live start)
# INTERVIEW_INTEL_GUIDE_GROQ_ENABLED=true
# INTERVIEW_INTEL_RESUME_EXCERPT_CHARS=1200
# INTERVIEW_INTEL_JD_EXCERPT_CHARS=800

# Enterprise interview report narrative (Groq)
# INTERVIEW_REPORT_GROQ_ENABLED=true

# Interview performance / payload / cache (optional; safe defaults)
# INTERVIEW_SUBMIT_ACOUSTIC_SAMPLES_MAX=2400
# INTERVIEW_SUBMIT_PAUSE_EVENTS_MAX=200
# INTERVIEW_PERSIST_TIMELINE_EVENTS_MAX=80
# INTERVIEW_PERSIST_PAUSE_EVENTS_MAX=80
# INTERVIEW_PERF_LOG_ENABLED=true
# INTERVIEW_ROLE_SUGGESTIONS_CACHE_TTL_MS=120000
# INTERVIEW_RESUME_ANALYSIS_CACHE_TTL_MS=300000

# Optional live-interviewer tuning (defaults are production-safe for mock interviews)
# VAPI_WAIT_SECONDS=1.0
# VAPI_SMART_ENDPOINTING_PROVIDER=livekit
# VAPI_STOP_SPEAKING_NUM_WORDS=3
# VAPI_INTERVIEWER_MODEL=gpt-4o-mini
# VAPI_INTERVIEWER_VOICE_PROVIDER=vapi
# VAPI_INTERVIEWER_VOICE_ID=Elliot
# VAPI_VOICE_FRIENDLY=Savannah
# VAPI_VOICE_NEUTRAL=Elliot
# VAPI_VOICE_STRICT=Rohan
# VAPI_VOICE_PANEL=Elliot
# VAPI_DURATION_BUFFER_SECONDS=120



# Resume Builder AI parser — primary provider (groq or gemini).
# The other provider is used automatically as fallback when configured.
AI_PROVIDER=groq

# Gemini (Resume Scanner / Builder fallback when Groq fails)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash



# Python PDF extraction microservice (resume import, resume builder, job description PDFs)

PYTHON_SERVICE_URL=http://localhost:8000

# Shared secret — required by python-service /extract (send as X-API-Key)
PYTHON_SERVICE_API_KEY=change_me_shared_secret_between_node_and_python
