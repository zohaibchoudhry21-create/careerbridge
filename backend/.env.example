PORT=5000

MONGO_URI=mongodb://127.0.0.1:27017/ai-careerbridge

CLIENT_URL=http://localhost:5173

API_URL=http://localhost:5000

JWT_SECRET=change_me_to_a_long_random_secret_before_production

JWT_EXPIRE=7d

NODE_ENV=development



# Email verification (SMTP)

SMTP_HOST=

SMTP_PORT=587

SMTP_SECURE=false

SMTP_USER=

SMTP_PASS=

EMAIL_FROM=

EMAIL_VERIFICATION_EXPIRE_MINUTES=15



# Google OAuth (https://console.cloud.google.com/)

GOOGLE_CLIENT_ID=

GOOGLE_CLIENT_SECRET=

# Optional: OAuth prompt (default: select_account consent)
# Use "select_account" in production if you only want consent on first authorization.
GOOGLE_OAUTH_PROMPT=select_account consent



# Facebook OAuth (https://developers.facebook.com/)

FACEBOOK_APP_ID=

FACEBOOK_APP_SECRET=



# LinkedIn OAuth (https://www.linkedin.com/developers/)

LINKEDIN_CLIENT_ID=

LINKEDIN_CLIENT_SECRET=



# Anthropic Claude (Resume Builder — import parsing & AI writing tools)
# https://console.anthropic.com/

ANTHROPIC_API_KEY=

ANTHROPIC_MODEL=claude-sonnet-4-20250514



# Groq (Resume Builder + Interview Prep — chat/JSON, quiz generation, STT via Whisper on Groq)
# https://console.groq.com/

GROQ_API_KEY=

GROQ_MODEL=llama-3.3-70b-versatile

GROQ_WHISPER_MODEL=whisper-large-v3



# Python PDF extraction microservice (resume import, resume builder, job description PDFs)

PYTHON_SERVICE_URL=http://localhost:8000

# Shared secret — required by python-service /extract (send as X-API-Key)
PYTHON_SERVICE_API_KEY=change_me_shared_secret_between_node_and_python
